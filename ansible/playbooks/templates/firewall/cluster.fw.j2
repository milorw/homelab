{# Managed by Ansible (firewall.yml). Do not edit by hand. #}
[OPTIONS]
{#
  This block did not exist, which is why `pve-firewall status` reported
  "disabled": the datacenter enable flag is the master switch, and without
  it every per-guest .fw file was written and then ignored.

  It is still off by default. Turning it on is a default-deny change
  affecting every guest at once, and getting it wrong needs console access
  rather than SSH - so it is a deliberate, separate step. See the comment
  on firewall_enabled in firewall.yml for what to check first.
#}
enable: {{ 1 if firewall_enabled | default(false) | bool else 0 }}
policy_in: DROP
policy_out: ACCEPT

{# Proxmox implicitly permits a `management` ipset to reach 8006, 22,
   SPICE (3128), VNC (5900-5999) and migration (60000-60050) on the node,
   regardless of anything in host.fw. That ipset is built from the
   local_network alias, which is auto-detected as the node's whole subnet
   unless it is defined here.

   Declaring [IPSET management] does NOT narrow it - Proxmox merges the
   declared entries with local_network rather than replacing them, so the
   full subnet stays in the set. Overriding the alias is what actually
   works, and there is no equivalent setting in the web UI.

   Scoped to the admin laptop. The node stays reachable from the tailnet
   and the edge router through the explicit rules in host.fw; what the rest
   of the LAN loses is SPICE and VNC console access. The browser console is
   unaffected, being proxied over 8006. #}
[ALIASES]
local_network {{ lan_laptop_ip }}/32

[IPSET edge_router]
{{ edge_router_ip }}/32

[IPSET lan_laptop]
{{ lan_laptop_ip }}/32

[IPSET lan_net]
{{ lan_net_cidr }}

[IPSET ts_net]
{{ ts_net_cidr }}

{# Retained as a record of the node's own tailnet identity, and because
   the playbook fails early if tailscale on the host is unhealthy. It is
   deliberately NOT used as a source in any inbound rule - see the note in
   host.fw.j2. #}
[IPSET ts_host]
{{ host_tailscale_ip }}/32
