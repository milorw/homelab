{# Managed by Ansible (docker-apps.yml). Do not edit by hand. #}

PORT={{ service_ports.sure }}
POSTGRES_USER={{ sure_postgres_user }}
POSTGRES_PASSWORD={{ sure_postgres_password }}
POSTGRES_DB={{ sure_postgres_db }}
SECRET_KEY_BASE={{ sure_secret_key_base }}
AI_ACCESS_TOKEN={{ sure_ai_access_token }}
AI_MODEL={{ sure_ai_model }}
AI_URI_BASE={{ sure_ai_uri_base }}

# Active Record encryption keys. Sure derives these from SECRET_KEY_BASE
# when they are not set, so these are the values already in use: pinning
# them re-encrypts nothing, silences the startup warning, and keeps the
# existing data readable if SECRET_KEY_BASE is ever rotated.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY={{ (sure_secret_key_base ~ ':primary_key') | hash('sha256') }}
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY={{ (sure_secret_key_base ~ ':deterministic_key') | hash('sha256') }}
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT={{ (sure_secret_key_base ~ ':key_derivation_salt') | hash('sha256') }}
