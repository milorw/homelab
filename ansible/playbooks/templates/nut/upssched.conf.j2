# {{ ansible_managed }}
# /etc/nut/upssched.conf - timers and event dispatch.
#
# upsmon's NOTIFYCMD points here rather than straight at nut-notify.sh,
# because upsmon itself has no concept of "shut down after N minutes on
# battery" - it only reacts to the UPS reporting low battery. upssched
# provides the timer; everything else is passed straight through.
#
# CMDSCRIPT receives the timer or EXECUTE name as $1 and fans it back out.

CMDSCRIPT {{ nut_upssched_cmd }}
PIPEFN {{ nut_upssched_pipe }}
LOCKFN {{ nut_upssched_lock }}

{% if nut_onbatt_timeout | int > 0 %}
# --- On-battery timeout ---
#
# Start counting when we go on battery, cancel the moment mains returns.
# {{ nut_onbatt_timeout }}s = {{ (nut_onbatt_timeout | int / 60) | round | int }} minutes.
#
# This does NOT replace the low-battery shutdown: upsmon runs SHUTDOWNCMD
# on LB by itself, without involving upssched at all. If this timer never
# fires the host still shuts down on a flat battery.
AT ONBATT * START-TIMER onbatt-timeout {{ nut_onbatt_timeout }}
AT ONLINE * CANCEL-TIMER onbatt-timeout

{% endif %}
# --- Event pass-through ---
#
# One line per event, because upssched has no wildcard for notify types.
# Anything not listed here reaches syslog via upsmon's own NOTIFYFLAG but
# never becomes an email, so keep this in step with nut_notify_flags.
{% for event in nut_notify_flags | dictsort %}
AT {{ "%-9s" | format(event[0]) }} * EXECUTE notify-{{ event[0] }}
{% endfor %}
