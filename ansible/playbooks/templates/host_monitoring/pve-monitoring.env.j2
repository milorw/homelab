# {{ ansible_managed }}
#
# Single config file for the host monitoring scripts in
# {{ pve_monitoring_bin }}. Every tunable lives here rather than inside
# the scripts, so changing a threshold is a group_vars edit and a re-run.
#
# 0600, and it holds the MQTT password - see docs/secrets.md.
#
# Sourced by bash, so every free-form value goes through the `quote`
# filter. An unquoted password containing a $ or a space would otherwise
# be mangled by the shell at load time.

# --- Alert delivery -----------------------------------------------------
# The scripts do not speak SMTP. They pipe into proxmox-mail-forward, so
# the real relay credentials are Proxmox's, in /etc/pve/notifications.cfg.
# These are only From:/To: header strings.
SMTP_FROM={{ alert_email_from | quote }}
SMTP_TO={{ alert_email_to | quote }}

# Comma-separated. Plain-language notifications for people who just want
# to know the server is going away. Empty disables them.
NOTIFY_USERS={{ alert_notify_users | quote }}

# --- Home Assistant MQTT ------------------------------------------------
MQTT_HOST={{ mqtt_host | quote }}
MQTT_PORT={{ mqtt_port }}
MQTT_USER={{ mqtt_user | quote }}
MQTT_PASS={{ mqtt_password | quote }}

# --- Disk selection (shared by hdd-temp-guard and hdd-fan-ramp) ---------
HDD_ROTATIONAL_ONLY={{ hdd_monitor_rotational_only | ternary(1, 0) }}
HDD_EXCLUDE_REGEX={{ hdd_monitor_exclude_regex | quote }}

# --- hdd-temp-guard -----------------------------------------------------
HDD_TEMP_WARN={{ hdd_temp_warn }}
HDD_TEMP_CRIT={{ hdd_temp_crit }}
HDD_TEMP_SHUTDOWN={{ hdd_temp_shutdown }}

HDD_RISE_WINDOW_SECONDS={{ hdd_rise_window_seconds }}
HDD_RISE_WARN={{ hdd_rise_warn }}
HDD_RISE_CRIT={{ hdd_rise_crit }}
HDD_RISE_SHUTDOWN={{ hdd_rise_shutdown }}

HDD_WARN_COOLDOWN={{ hdd_warn_cooldown }}
HDD_CRIT_COOLDOWN={{ hdd_crit_cooldown }}

# --- hdd-fan-ramp -------------------------------------------------------
FAN_SERIAL_DEV={{ fan_serial_dev | quote }}
FAN_BAUD={{ fan_baud }}
FAN_POLL_INTERVAL={{ fan_poll_interval }}
FAN_TEMP_FLOOR={{ fan_temp_floor }}
FAN_TEMP_MID={{ fan_temp_mid }}
FAN_TEMP_CEILING={{ fan_temp_ceiling }}
FAN_MIN_PCT={{ fan_min_pct }}
FAN_MID_PCT={{ fan_mid_pct }}
FAN_MAX_PCT={{ fan_max_pct }}

# Aux fans: one follows the boot SSD, one is held at a fixed level.
FAN_SSD_CHANNEL={{ fan_ssd_channel }}
FAN_FIXED_CHANNEL={{ fan_fixed_channel }}
FAN_FIXED_PCT={{ fan_fixed_pct }}
FAN_SSD_DEVICE={{ fan_ssd_device | quote }}
FAN_SSD_TEMP_FLOOR={{ fan_ssd_temp_floor }}
FAN_SSD_TEMP_MID={{ fan_ssd_temp_mid }}
FAN_SSD_TEMP_CEILING={{ fan_ssd_temp_ceiling }}
FAN_FAILSAFE_PCT={{ fan_failsafe_pct }}

# --- proxmox-stats ------------------------------------------------------
ZFS_WARN_PCT={{ zfs_warn_pct }}
ZFS_CRIT_PCT={{ zfs_crit_pct }}
ZFS_HEALTH_COOLDOWN={{ zfs_health_cooldown }}
ZFS_WARN_COOLDOWN={{ zfs_warn_cooldown }}
ZFS_CRIT_COOLDOWN={{ zfs_crit_cooldown }}

# --- Minecraft SSD backup -----------------------------------------------
MC_BACKUP_SRC_LV={{ minecraft_backup_src_lv | quote }}
MC_BACKUP_DEST={{ minecraft_backup_dest | quote }}
MC_BACKUP_KEEP={{ minecraft_backup_keep }}
MC_BACKUP_SNAP_SIZE={{ minecraft_backup_snapshot_size | quote }}

# --- ZFS snapshots ------------------------------------------------------
# Retention is a table, so it lives in its own file rather than here.
SNAPSHOT_POLICY_FILE={{ snapshot_policy_file | quote }}

# --- pve-shutdown -------------------------------------------------------
SHUTDOWN_VM_TIMEOUT={{ shutdown_vm_timeout }}
