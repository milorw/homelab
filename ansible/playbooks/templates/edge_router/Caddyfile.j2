{# Managed by Ansible (edge-router.yml). Do not edit by hand. #}

{% for domain, dattrs in edge_domains.items() %}
({{ domain.split('.')[0] }}_cf) {
  tls {
    dns cloudflare {env.{{ dattrs.cf_env_name }}}
  }
}
{% endfor %}
{% for service, attrs in edge_services.items() %}
({{ service }}) {
  bind {{ edge_tailscale_ip }} {{ ansible_host }}
  encode {{ attrs.encodings | join(' ') }}
{# Log failed requests only. #}
  log {
    level ERROR
  }
{% for rp in attrs.reverse_proxy %}
{% set prefix = (rp.path ~ ' ') if rp.path is defined else '' %}
  reverse_proxy {{ prefix }}{{ rp.address }}:{{ rp.port }} {
{% if rp.headers is defined %}
{% for hdr, val in rp.headers.items() %}
    header_up {{ hdr }} {{ '{host}' if val == 'host' else ('{upstream_hostport}' if val == 'upstream' else val) }}
{% endfor %}
{% endif %}
    transport http {
{# Short, or a powered-off backend hangs the browser instead of showing the error page. #}
      dial_timeout {{ edge_dial_timeout }}
{% for directive in rp.transport_http | default([]) %}
      {{ directive }}
{% endfor %}
    }
{# A gateway 5xx from the app itself: up, but not serving yet. 500 is left
   alone - it's a real app error, and HTML would break API clients. #}
    @backend_unready status 502 503 504
    handle_response @backend_unready {
      header Cache-Control "no-store"
      root * {{ edge_errors_container_dir }}
      rewrite * /starting.html
      file_server {
        status {rp.status_code}
      }
    }
  }
{% endfor %}
{# No response at all. Stopped and still-booting look identical from here -
   see docs/Ansible/edge-router.md. #}
  handle_errors 502 503 504 {
    header Cache-Control "no-store"
    root * {{ edge_errors_container_dir }}
    rewrite * /unreachable.html
    file_server {
      status {err.status_code}
    }
  }
}
{% endfor %}
{% for service, sattrs in edge_services.items() %}
{% for domain, dattrs in edge_domains.items() %}
{% if service in dattrs.services %}
{{ service }}.{{ domain }} {
  import {{ domain.split('.')[0] }}_cf
  import {{ service }}
}
{% endif %}
{% endfor %}
{% endfor %}
