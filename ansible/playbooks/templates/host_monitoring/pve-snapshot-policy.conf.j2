# {{ ansible_managed }}
#
# ZFS snapshot retention, read by {{ pve_monitoring_bin }}/zfs-snapshot.sh.
#
# Columns:
#   dataset      the ZFS dataset to snapshot
#   recursive    yes -> snapshot the dataset and all its children together,
#                under one atomic transaction and one shared snapshot name
#   hourly daily weekly monthly
#                how many snapshots of each frequency to keep. 0 means the
#                frequency is not taken for this dataset - and that any
#                existing ones get pruned away on the next run, so lowering
#                a number here is how you reclaim the space.
#
# A dataset absent from this table is never snapshotted and never touched.
# The script will also only ever destroy snapshots named autosnap_*, so
# anything taken by hand or by vzdump is safe from it regardless.
#
# Edit snapshot_policy in group_vars, not this file.

# dataset              recursive  hourly  daily  weekly  monthly
{% for p in snapshot_policy %}
{{ '%-22s' | format(p.dataset) }} {{ '%-10s' | format(p.recursive | ternary('yes', 'no')) }} {{ '%-7s' | format(p.hourly) }} {{ '%-6s' | format(p.daily) }} {{ '%-7s' | format(p.weekly) }} {{ p.monthly }}
{% endfor %}
